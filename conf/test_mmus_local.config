params {
    config_profile_name        = 'Mouse local, no-Gemma test profile'
    config_profile_description = 'Mouse local study_paths (MEX sample directory) input with use_gemma=false to check the credential-free path'

    study_paths = '/space/grp/rschwartz/rschwartz/get_gemma_data.nf/study_names_mouse.txt_author_true_process_samples_true/mex/GSE231868'

    organism        = 'mus_musculus'
    census_version  = '2024-07-01'
    subsample_ref   = 500
    process_samples = false
    cutoff          = 0
    seed            = 42
    nmads           = [mito: 20, umi: 5, genes: 5, counts: 5]

    use_gemma       = false

    ref_collections = [
        "A taxonomy of transcriptomic cell types across the isocortex and hippocampal formation",
        "An integrated transcriptomic and epigenomic atlas of mouse primary motor cortex cell types",
        "Tabula Muris Senis"
    ]
    // mouse rename file keys on author_cell_type, needs these set (can't null like human)
    original_celltype_columns  = "${projectDir}/assets/original_celltype_columns.tsv"
    author_annotations_path    = "${projectDir}/assets/author_cell_annotations"

    preferredCtaLevel = 'family'
}

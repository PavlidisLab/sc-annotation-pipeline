/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/scannotate Base Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resource requirements for all processes
----------------------------------------------------------------------------------------
*/

process {

    // Default resources - can be overridden per process
    cpus   = 1
    memory = 32.GB
    // time   = { 4.h * task.attempt }

    errorStrategy = {
        if (task.exitStatus == 42) return 'ignore'           // empty/small samples
       // if (task.exitStatus == 132) return 'terminate'       // SIGILL - CPU incompatibility, don't retry
        if (task.exitStatus in ((130..145) + 104)) return 'retry'
        return 'finish'
    }
    maxRetries    = 1
    maxErrors     = '-1'

    // Memory stays flat at 32GB everywhere (unchanged from the old blanket
    // clusterOptions) - only cpus are tiered by label, since over-reserving
    // idle cores (not memory) is what was clogging the SLURM queue.
    withLabel:process_single {
        cpus = 1
    }

    withLabel:process_medium {
        cpus = 4
    }

    withLabel:process_high {
        cpus = 8
    }
}

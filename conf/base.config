/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/scannotate Base Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resource requirements for all processes
----------------------------------------------------------------------------------------
*/

process {

    // Default resources - can be overridden per process
    cpus   = 1
    // memory = { 6.GB * task.attempt }
    // time   = { 4.h * task.attempt }

    errorStrategy = {
        if (task.exitStatus == 42) return 'ignore'           // empty/small samples
       // if (task.exitStatus == 132) return 'terminate'       // SIGILL - CPU incompatibility, don't retry
        if (task.exitStatus in ((130..145..132) + 104)) return 'retry'
        return 'finish'
    }
    maxRetries    = 1
    maxErrors     = '-1'

    /*
    // Process-specific resource requirements (commented out - not using labels)
    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
    }

    withLabel:process_low {
        cpus   = 2
        memory = { 12.GB * task.attempt }
    }

    withLabel:process_medium {
        cpus   = 6
        memory = { 36.GB * task.attempt }
    }

    withLabel:process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
    }

    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 1
    }
    */
}

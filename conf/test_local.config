params {
    config_profile_name        = 'Local, no-Gemma test profile'
    config_profile_description = 'Local study_paths (single .h5ad) input with use_gemma=false to check the credential-free path'

    study_paths = '/space/grp/rschwartz/rschwartz/get_gemma_data.nf/psychEncode_author_false_sample_split_false/homo_sapiens/DevBrain.h5ad'

    organism        = 'homo_sapiens'
    census_version  = '2024-07-01'
    organ           = 'brain'
    subsample_ref   = 500
    process_samples = false
    cutoff          = 0
    seed            = 42
    nmads           = [mito: 20, umi: 5, genes: 5, counts: 5]

    use_gemma       = false

    ref_collections = [
        "Transcriptomic cytoarchitecture reveals principles of human neocortex organization",
        "SEA-AD: Seattle Alzheimer’s Disease Brain Cell Atlas"
    ]
    rename_file                = "${projectDir}/assets/rename_cells_homo_sapiens.tsv"
    original_celltype_columns  = null
    author_annotations_path    = null

    preferredCtaLevel = 'class'
}

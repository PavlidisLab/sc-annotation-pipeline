/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/scannotate Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // pipeline version
    version                    = '2.0.0'
    // Input options
    input                      = null  // Samplesheet CSV file
    study_names                = null  // Space-separated study names or file (legacy)
    study_paths                = null  // Space-separated study paths or file (legacy)

    // Reference options
    organism                   = 'mus_musculus'
    census_version             = '2024-07-01'
    organ                      = 'brain'
    subsample_ref              = 500
    ref_collections            = [
        "A taxonomy of transcriptomic cell types across the isocortex and hippocampal formation",
        "An integrated transcriptomic and epigenomic atlas of mouse primary motor cortex cell types",
        "Tabula Muris Senis"
    ]
    ref_keys                   = ["subclass_cell_type", "class_cell_type", "family_cell_type"]

    // Classification options
    cutoff                     = 0
    seed                       = 42
    process_samples            = false
    preferredCtaLevel          = 'class'
    // QC options
    nmads                      = [mito: 20, umi: 5, genes: 5, counts: 5]

    // Asset files
    rename_file                = "${projectDir}/assets/rename_cells_${params.organism}.tsv"
    gene_mapping               = "${projectDir}/assets/gemma_genes.tsv"
    markers_file               = "${projectDir}/assets/cell_type_markers.tsv"
    multiqc_config             = "${projectDir}/assets/multiqc_config.yaml"
    original_celltype_columns  = "${projectDir}/assets/original_celltype_columns.tsv"
    author_annotations_path    = "${projectDir}/assets/author_cell_annotations"

    // Gemma options
    use_staging                = true
    GEMMA_USERNAME             = System.getenv('GEMMA_USERNAME')
    GEMMA_PASSWORD             = System.getenv('GEMMA_PASSWORD')
    // Master switch: set --use_gemma false to skip all Gemma interaction (both
    // per-sample metadata fetch during QC and uploads). Needed for studies provided via
    // --study_paths / local samplesheet rows that don't exist in Gemma. Downloading
    // studies by name (--study_names) still requires credentials since that's an
    // explicit Gemma fetch.
    use_gemma                  = true

    // Upload options (enabled by default)
    // Set --upload_gemma false to skip the upload subworkflow specifically, while still
    // fetching metadata (e.g. read access but no write access, or opting out of writing
    // test runs back to Gemma). Only takes effect when use_gemma is also true.
    upload_gemma               = true
    upload_cta                 = true
    upload_clc                 = true
    upload_mask                = true
    upload_multiqc             = true

    // Output options
    outdir                     = "${projectDir}/results/${params.organism}_subsample_ref_${params.subsample_ref}_${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd_HH-mm-ss'))}"
    publish_dir_mode           = 'copy'

    // Schema validation default options
    validationFailUnrecognisedParams = false
    validationLenientMode            = false
    validationSchemaIgnoreParams     = 'genomes,igenomes_base'
    validationShowHiddenParams       = false
    validate_params                  = true

}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load modules.config for DSL2 module-specific options
includeConfig 'conf/modules.config'

// Enable conda by default
conda.enabled = true

// Manifest
manifest {
    name            = 'nf-core/scannotate'
    author          = """Rachel Schwartz, Pavlidis Lab"""
    homePage        = 'https://github.com/PavlidisLab/sc-annotation-pipeline'
    description     = """Nextflow pipeline for automated single-cell cell type annotation using scVI embeddings and random forest classification"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '2.0.0dev'
    doi             = ''
}

// Profiles
profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }

    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions      = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    test_mouse           { includeConfig 'conf/test_mmus.config'           }
    test_human           { includeConfig 'conf/test_hsap.config'           }
    test_mouse_persample { includeConfig 'conf/test_mmus_persample.config' }
    test_local           { includeConfig 'conf/test_local.config'          }
    test_upload_off      { includeConfig 'conf/test_upload_off.config'     }
}

// Executor settings for SLURM (default)
process.executor       = 'slurm'
process.clusterOptions = '-C thrd64'
executor.queueSize     = 25

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    NUMBA_CACHE_DIR  = 'numba_cache'
    MPLCONFIGDIR     = 'mplconfig'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']
process.beforeScript = 'mkdir -p numba_cache mplconfig'

// Set default registry for Apptainer, Docker, Podman and Singularity independent of -profile
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Nextflow plugins
plugins {
    id 'nf-validation@1.1.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// DAG settings
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.dot"
}

// Timeline report
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}

// Execution report
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}

// Trace report
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
